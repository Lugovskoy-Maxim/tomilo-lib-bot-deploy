# Telegram. В MAX-only режиме задайте TELEGRAM_ENABLED=false и оставьте поля пустыми.
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=replace_me
# Имя личного бота без @. Ссылка из профиля сайта должна вести сюда.
TELEGRAM_BOT_USERNAME=tomilo_lib_bot
TELEGRAM_CHAT_ID=-1001234567890
# Новые тайтлы публикуются и в TELEGRAM_CHAT_ID, и в топике ниже.
# Новые главы публикуются в этой группе, в указанном топике.
# Если CHAT_ID не задан, используется TELEGRAM_CHAT_ID2.
TELEGRAM_CHAPTERS_CHAT_ID=
TELEGRAM_CHAPTERS_THREAD_ID=44
# Группа с форумом для жалоб и ID темы. Допустима запись -1001234567890_3.
TELEGRAM_CHAT_ID2=-1001234567890
TELEGRAM_REPORTS_THREAD_ID=3
NOTIFY_REPORTS=true
REPORTS_POLL_INTERVAL_MS=15000

# MAX: создайте чат-бота, добавьте его администратором в канал и укажите его chat_id.
# При false бот работает только с Telegram.
MAX_ENABLED=false
MAX_BOT_TOKEN=
MAX_CHAT_ID=
# Путь внутри контейнера к PEM c корневым и выпускающим сертификатами Минцифры.
# NODE_EXTRA_CA_CERTS=/certs/mincifry.pem

# API и сайт
API_URL=https://example.com/api
SITE_URL=https://example.com
IMAGE_BASE_URL=https://example.com
# Необязательно: облачное хранилище обложек
IMAGE_CLOUD_BASE_URL=
# Интервал опроса в миллисекундах (по умолчанию 300000 = 5 мин)
POLL_INTERVAL_MS=300000
# Тихие часы по Москве: уведомления не отправляются, а накопленные выйдут после 08:00.
QUIET_HOURS_START=00:00
QUIET_HOURS_END=08:00
# Пауза между любыми сообщениями и максимум за одну проверку.
MESSAGE_COOLDOWN_MS=2000
MAX_PUBLIC_NOTIFICATIONS_PER_RUN=5
MAX_PERSONAL_NOTIFICATIONS_PER_RUN=5
# Пост о приложении — раз в день; о поддержке — не чаще раза в 4 часа.
NOTIFY_DAILY_APP_PROMO=true
NOTIFY_DAILY_SUPPORT=true
NOTIFY_MONTHLY_LEADERS=true
MONTHLY_LEADERS_INTERVAL_HOURS=168
# Памятка о скрытых главах: по умолчанию раз в 7 дней, можно отключить.
NOTIFY_HIDDEN_CHAPTERS_GUIDE=true
HIDDEN_CHAPTERS_GUIDE_INTERVAL_HOURS=168
# Минимальное значение — 240. Бот не позволит поставить меньший интервал.
SUPPORT_PROMO_INTERVAL_MINUTES=240
DAILY_PROMOTION_PAUSE_MINUTES=20
# Случайная реакция на пост; 15% публикаций остаются без неё.
POST_REACTIONS_ENABLED=true
POST_REACTION_SKIP_PERCENT=15
RUSTORE_URL=https://www.rustore.ru/catalog/app/ru.tomilo.lib.mobile
GITHUB_RELEASES_URL=https://github.com/Lugovskoy-Maxim/tomilo-lib-android/releases
DONATE_URL=
DONATE_URL_TBANK=
# Тот же секрет, что TELEGRAM_BOT_API_SECRET на сервере — для личных уведомлений и жалоб
BOT_API_SECRET=
# Оповещения: true/false
NOTIFY_NEW_CHAPTERS=true
NOTIFY_PERSONAL_BOOKMARKS=true
NOTIFY_NEW_TITLES=true
NOTIFY_LEADERBOARD=false
NOTIFY_MILESTONE_CHAPTERS=false
NOTIFY_DAILY_VIEWS=false
# Генерировать фирменную карточку: логотип, обложка справа и номер главы.
USE_ENHANCED_COVERS=true

# false — обычный запуск; true — подключить WireGuard из ./wireguard/wg0.conf
WG_ENABLED=false
# Через VPN Telegram, напрямую из контейнера — API сайта (несколько доменов через пробел).
WG_BYPASS_HOSTS=tomilo-lib.ru cdn.tomilo-lib.ru
